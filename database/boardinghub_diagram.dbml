}

Enum expense_category {
  REPAIR
  CLEANING
  COMMON_ELECTRICITY
  COMMON_WATER
  INTERNET
  OTHER
}
Enum expense_status {
  RECORDED
  VOIDED
}
Enum reminder_status {
  OPEN
  DONE
  DISMISSED
}
Enum notification_channel {
  IN_APP
  EMAIL
  SMS
}
Enum notification_status {
  PENDING
  SENT
  FAILED
  READ
}

Enum backup_status {
  RUNNING
  SUCCEEDED
  FAILED
}
Enum restore_status {
  RUNNING
  PASSED
  FAILED
}
Enum idempotency_status {
  IN_PROGRESS
  COMPLETED
  FAILED
}

//////////////////////////////////////////////////////////////
// EP01 - TÀI KHOẢN VÀ PHÂN QUYỀN
//////////////////////////////////////////////////////////////

Table ep01_accounts.users [headercolor: #475569] {
  id bigint [pk, increment]
  email varchar(190) [not null, unique]
  password_hash varchar(255) [not null, note: 'BCrypt/Argon2; không lưu mật khẩu rõ']
  full_name varchar(150) [not null]
  phone varchar(30)
  status user_status [not null, default: 'ACTIVE']
  is_platform_admin boolean [not null, default: false]
  last_login_at datetime(6)
  failed_login_count int [not null, default: 0]
  version int [not null, default: 0]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  Note: 'Tài khoản đăng nhập. Người thuê có tài khoản được liên kết qua persons.user_id (US-001).'
}

Table ep01_accounts.roles [headercolor: #475569] {
  id bigint [pk, increment]
  code varchar(50) [not null, unique, note: 'OWNER, STAFF, PLATFORM_ADMIN, OPERATOR']
  name varchar(120) [not null]
  scope role_scope [not null]
  is_system boolean [not null, default: true]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  Note: 'Vai trò gán theo phạm vi. Người thuê đại diện/ở cùng KHÔNG gán ở đây mà suy ra từ occupancies đang hiệu lực.'
}

Table ep01_accounts.permissions [headercolor: #475569] {
  id bigint [pk, increment]
  code varchar(100) [not null, unique, note: 'Ví dụ PAYMENT_RECORD, DEPOSIT_REFUND, INVOICE_ISSUE']
  module varchar(40) [not null, note: 'EP01..EP15']
  description varchar(255)
  is_sensitive boolean [not null, default: false, note: 'Quyền phải cấp riêng (PC riêng)']
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
}

Table ep01_accounts.role_permissions [headercolor: #475569] {
  id bigint [pk, increment]
  role_id bigint [not null, ref: > ep01_accounts.roles.id]
  permission_id bigint [not null, ref: > ep01_accounts.permissions.id]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (role_id, permission_id) [unique, name: 'uq_role_permissions']
  }
  Note: 'Quyền mặc định của vai trò. Quyền nhạy cảm (is_sensitive) chỉ OWNER có mặc định; nhân viên được cấp riêng qua assignment_permission_grants.'
}

Table ep01_accounts.user_role_assignments [headercolor: #475569] {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > ep01_accounts.users.id]
  role_id bigint [not null, ref: > ep01_accounts.roles.id]
  organization_id bigint [not null, ref: > ep02_properties.organizations.id]
  property_id bigint [ref: >? ep02_properties.properties.id, note: 'NULL = toàn tổ chức']
  room_id bigint [ref: >? ep02_properties.rooms.id, note: 'NULL = toàn khu']
  granted_by bigint [ref: >? ep01_accounts.users.id]
  granted_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  revoked_at datetime(6) [note: 'Thu hồi có hiệu lực ngay ở request kế tiếp (AC-001-03)']
  revoked_by bigint [ref: >? ep01_accounts.users.id]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (user_id, revoked_at) [name: 'idx_ura_user_active']
    (organization_id, property_id) [name: 'idx_ura_scope']
  }
  Note: 'Phân công chủ trọ/nhân viên theo tổ chức, khu hoặc phòng (BR-001).'
}

Table ep01_accounts.assignment_permission_grants [headercolor: #475569] {
  id bigint [pk, increment]
  assignment_id bigint [not null, ref: > ep01_accounts.user_role_assignments.id]
  permission_id bigint [not null, ref: > ep01_accounts.permissions.id]
  granted_by bigint [not null, ref: > ep01_accounts.users.id]
  granted_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  revoked_at datetime(6)
  revoked_by bigint [ref: >? ep01_accounts.users.id]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (assignment_id, permission_id) [name: 'idx_apg_assignment_permission']
  }
  Note: 'Quyền cấp riêng cho một lượt phân công: thu tiền, hoàn cọc, xem nhật ký... (ma trận quyền "PC riêng").'
}

Table ep01_accounts.support_access_grants [headercolor: #475569] {
  id bigint [pk, increment]
  admin_user_id bigint [not null, ref: > ep01_accounts.users.id]
  organization_id bigint [not null, ref: > ep02_properties.organizations.id]
  entity_type varchar(60) [not null]
  entity_id bigint [not null]
  reason varchar(500) [not null]
  granted_by bigint [not null, ref: > ep01_accounts.users.id, note: 'Chủ trọ hoặc người có thẩm quyền theo Q14']
  valid_from datetime(6) [not null]
  valid_to datetime(6) [not null]
  revoked_at datetime(6)
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (admin_user_id, entity_type, entity_id) [name: 'idx_sag_admin_entity']
  }
  Note: 'Quyền HT: quản trị nền tảng chỉ xem hồ sơ riêng khi được cấp theo từng hồ sơ, có thời hạn.'
}

//////////////////////////////////////////////////////////////
// EP02 - TỔ CHỨC, KHU TRỌ, PHÒNG, CHÍNH SÁCH
//////////////////////////////////////////////////////////////

Table ep02_properties.organizations [headercolor: #0F766E] {
  id bigint [pk, increment]
  name varchar(150) [not null]
  owner_user_id bigint [not null, ref: > ep01_accounts.users.id]
  phone varchar(30)
  email varchar(190)
  status record_status [not null, default: 'ACTIVE']
  version int [not null, default: 0]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  Note: 'Chủ thể chủ trọ. Mọi dữ liệu riêng gắn organization_id để cô lập giữa các chủ trọ (AC-001-02).'
}

Table ep02_properties.properties [headercolor: #0F766E] {
  id bigint [pk, increment]
  organization_id bigint [not null, ref: > ep02_properties.organizations.id]
  code varchar(30) [not null]
  name varchar(150) [not null]
  address varchar(255) [not null]
  ward varchar(100)
  district varchar(100)
  city varchar(100)
  timezone varchar(64) [not null, default: 'Asia/Ho_Chi_Minh']
  status record_status [not null, default: 'ACTIVE']
  version int [not null, default: 0]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (organization_id, code) [unique, name: 'uq_properties_org_code']
  }
}

Table ep02_properties.rooms [headercolor: #0F766E] {
  id bigint [pk, increment]
  organization_id bigint [not null, ref: > ep02_properties.organizations.id]
  property_id bigint [not null, ref: > ep02_properties.properties.id]
  code varchar(30) [not null]
  floor_no int
  capacity int [not null, note: 'CHECK > 0']
  area_m2 decimal(10,2)
  listed_rent decimal(18,2) [not null, default: 0, note: 'Giá niêm yết; không ảnh hưởng hợp đồng đã ký']
  status room_status [not null, default: 'VACANT']
  description text
  version int [not null, default: 0]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (property_id, code) [unique, name: 'uq_rooms_property_code']
    (organization_id, status) [name: 'idx_rooms_org_status']
  }
  Note: 'BR-003. Không xóa phòng đã có lịch sử; chuyển INACTIVE (AC-002-02).'
}

Table ep02_properties.room_status_history [headercolor: #0F766E] {
  id bigint [pk, increment]
  room_id bigint [not null, ref: > ep02_properties.rooms.id]
  from_status room_status
  to_status room_status [not null]
  reason varchar(255)
  changed_by bigint [ref: >? ep01_accounts.users.id]
  changed_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (room_id, changed_at) [name: 'idx_rsh_room_time']
  }
}

Table ep02_properties.business_policies [headercolor: #0F766E] {
  id bigint [pk, increment]
  organization_id bigint [ref: >? ep02_properties.organizations.id, note: 'NULL = mặc định toàn hệ thống']
  policy_code varchar(60) [not null, note: 'ROUNDING, PRORATION, PAYMENT_ALLOCATION, OVERPAYMENT, BILLING_CYCLE, BUSINESS_TIMEZONE, ABSENCE_APPROVAL, FUND_LIFECYCLE, RETENTION, BACKUP']
  revision_no int [not null]
  value_json json [not null]
  decision_ref varchar(20) [note: 'Mã câu hỏi Q01..Q14']
  effective_from date [not null]
  status policy_status [not null, default: 'DRAFT']
  approved_by bigint [ref: >? ep01_accounts.users.id]
  approved_at datetime(6)
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (organization_id, policy_code, revision_no) [unique, name: 'uq_policies_org_code_rev']
  }
  Note: 'Lưu quyết định Q01-Q14 có phiên bản và ngày hiệu lực. Chứng từ lưu policy_id đã dùng.'
}

//////////////////////////////////////////////////////////////
// EP03 + EP04 - NGƯỜI THUÊ, HỢP ĐỒNG, GIA HẠN, GIÁ, CỌC
//////////////////////////////////////////////////////////////

Table ep03_ep04_contracts.persons [headercolor: #1D4ED8] {
  id bigint [pk, increment]
  organization_id bigint [not null]
  user_id bigint [ref: >? ep01_accounts.users.id, note: 'NULL nếu người thuê chưa có tài khoản']
  full_name varchar(150) [not null]
  phone varchar(30)
  email varchar(190)
  date_of_birth date
  identity_number varchar(255) [note: 'Tùy chọn; mã hóa ở tầng ứng dụng; không ghi vào log']
  permanent_address varchar(255)
  created_by bigint
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (organization_id, user_id) [unique, name: 'uq_persons_org_user']
    (organization_id, phone) [name: 'idx_persons_org_phone']
  }
  Note: 'Người thuê tách khỏi lượt ở để giữ lịch sử. Chỉ bắt buộc dữ liệu cần thiết (luồng tiếp nhận bước 2).'
}

Table ep03_ep04_contracts.contracts [headercolor: #1D4ED8] {
  id bigint [pk, increment]
  organization_id bigint [not null]
  room_id bigint [not null, ref: > ep02_properties.rooms.id]
  representative_person_id bigint [not null, ref: > ep03_ep04_contracts.persons.id]
  code varchar(60) [not null]
  start_date date [not null]
  end_date date [not null, note: 'Ngày kết thúc hiện hành; lịch sử ở contract_versions']
  billing_cycle billing_cycle [not null, default: 'CALENDAR_MONTH']
  billing_anchor_day tinyint [not null, default: 1, note: '1..28; ngày bắt đầu kỳ thu']
  payment_due_days int [not null, default: 5, note: 'Hạn đóng = ngày phát hành + N ngày']
  proration_policy proration_policy [not null, default: 'NOT_SET', note: 'Q02, BR-012']
  rounding_policy_id bigint [ref: >? ep02_properties.business_policies.id, note: 'Q04, BR-013']
  deposit_required decimal(18,2) [not null, default: 0]
  status contract_status [not null, default: 'DRAFT']
  activated_at datetime(6)
  activated_by bigint
  terminated_at datetime(6)
  termination_reason varchar(255)
  cancelled_reason varchar(255)
  created_by bigint
  version int [not null, default: 0]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (organization_id, code) [unique, name: 'uq_contracts_org_code']
    (room_id, status) [name: 'idx_contracts_room_status']
    (end_date) [name: 'idx_contracts_end_date']
  }
  Note: '''
  BR-004: một phòng tối đa một hợp đồng ACTIVE/EXPIRED (unique trên cột sinh active_room_key ở V2).
  Hết hạn chuyển EXPIRED, không tự kết thúc lượt ở hay hoàn cọc. Giá thuê lấy từ rent_rates.
  '''
}

Table ep03_ep04_contracts.contract_versions [headercolor: #1D4ED8] {
  id bigint [pk, increment]
  contract_id bigint [not null, ref: > ep03_ep04_contracts.contracts.id]
  revision_no int [not null]
  change_type contract_change_type [not null]
  start_date date [not null]
  end_date date [not null]
  effective_from date [not null]
  terms_json json [not null, note: 'Snapshot điều khoản: dịch vụ, chính sách, ghi chú']
  change_reason varchar(255)
  status version_status [not null, default: 'DRAFT']
  created_by bigint
  approved_by bigint
  approved_at datetime(6)
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (contract_id, revision_no) [unique, name: 'uq_contract_versions_rev']
  }
  Note: 'BR-005, US-005: gia hạn, kết thúc sớm, đổi điều khoản có phiên bản; truy xuất được bản trước.'
}

Table ep03_ep04_contracts.rent_rates [headercolor: #1D4ED8] {
  id bigint [pk, increment]
  contract_id bigint [not null, ref: > ep03_ep04_contracts.contracts.id]
  contract_version_id bigint [ref: >? ep03_ep04_contracts.contract_versions.id]
  effective_from date [not null]
  effective_to date [note: 'NULL = đến khi có giá mới']
  monthly_rent decimal(18,2) [not null]
  reason varchar(255)
  created_by bigint
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (contract_id, effective_from) [unique, name: 'uq_rent_rates_contract_from']
  }
  Note: 'Nguồn duy nhất của giá thuê theo ngày hiệu lực. Đổi giá giữa kỳ -> hóa đơn chia đoạn (AC-005-03).'
}

Table ep03_ep04_contracts.contract_services [headercolor: #1D4ED8] {
  id bigint [pk, increment]
  contract_id bigint [not null, ref: > ep03_ep04_contracts.contracts.id]
  service_id bigint [not null, ref: > ep06_utilities.services.id]
  quantity decimal(12,2) [not null, default: 1, note: 'Ví dụ số người với phí PER_PERSON']
  unit_price_override decimal(18,2) [note: 'NULL = dùng service_prices']
  effective_from date [not null]
  effective_to date
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (contract_id, service_id, effective_from) [unique, name: 'uq_contract_services']
  }
  Note: 'Dịch vụ áp dụng cho hợp đồng (luồng tiếp nhận bước 3).'
}

Table ep03_ep04_contracts.occupancies [headercolor: #1D4ED8] {
  id bigint [pk, increment]
  organization_id bigint [not null]
  contract_id bigint [not null, ref: > ep03_ep04_contracts.contracts.id]
  room_id bigint [not null, ref: > ep02_properties.rooms.id, note: 'Phi chuẩn hóa để kiểm sức chứa và quyền nhanh']
  person_id bigint [not null, ref: > ep03_ep04_contracts.persons.id]
  role occupancy_role [not null, default: 'MEMBER']
  move_in_date date [not null]
  move_out_date date [note: 'CHECK >= move_in_date']
  status occupancy_status [not null, default: 'PLANNED']
  end_reason varchar(255)
  created_by bigint
  version int [not null, default: 0]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (contract_id, status) [name: 'idx_occupancies_contract_status']
    (room_id, status) [name: 'idx_occupancies_room_status']
    (person_id) [name: 'idx_occupancies_person']
  }
  Note: 'Lượt cư trú. Kiểm sức chứa khi thêm (BR-003). Là căn cứ quyền người thuê và Ngày Người (BR-021).'
}

Table ep03_ep04_contracts.deposit_transactions [headercolor: #1D4ED8] {
  id bigint [pk, increment]
  organization_id bigint [not null]
  contract_id bigint [not null, ref: > ep03_ep04_contracts.contracts.id]
  type deposit_txn_type [not null]
  amount decimal(18,2) [not null, note: 'CHECK > 0']
  occurred_at datetime(6) [not null]
  method payment_method
  checkout_id bigint [ref: >? ep08_checkout.checkouts.id, note: 'Bắt buộc với APPLY_TO_DEBT và REFUND khi trả phòng']
  reverses_transaction_id bigint [ref: >? ep03_ep04_contracts.deposit_transactions.id, note: 'Bút toán đảo khi ghi sai']
  idempotency_key varchar(100) [not null, unique]
  reference_code varchar(100)
  note varchar(255)
  recorded_by bigint [not null]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (contract_id, type) [name: 'idx_deposit_txn_contract_type']
  }
  Note: '''
  BR-006: cọc theo dõi riêng. Cọc khả dụng = RECEIVE - APPLY_TO_DEBT - REFUND, không âm (khóa dòng contracts khi ghi).
  Nhận cọc thiếu vẫn ghi (AC-004-03). Không cộng vào tiền thuê thực thu.
  '''
}

//////////////////////////////////////////////////////////////
// EP05 - TÀI SẢN VÀ BÀN GIAO
//////////////////////////////////////////////////////////////

Table ep05_handover.room_assets [headercolor: #0369A1] {
  id bigint [pk, increment]
  organization_id bigint [not null]
  room_id bigint [not null, ref: > ep02_properties.rooms.id]
  asset_code varchar(50) [not null]
  asset_name varchar(150) [not null]
  unit varchar(30)
  quantity decimal(12,2) [not null, default: 1]
  reference_value decimal(18,2) [note: 'Giá trị tham khảo, không tự áp làm tiền bồi thường (BR-018)']
  status asset_status [not null, default: 'IN_USE']
  note varchar(255)
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (room_id, asset_code) [unique, name: 'uq_room_assets_code']
  }
}

Table ep05_handover.handovers [headercolor: #0369A1] {
  id bigint [pk, increment]
  organization_id bigint [not null]
  contract_id bigint [not null, ref: > ep03_ep04_contracts.contracts.id]
  type handover_type [not null]
  revision_no int [not null, default: 1]
  supersedes_handover_id bigint [ref: >? ep05_handover.handovers.id, note: 'Sửa bản đã xác nhận tạo bản mới (AC-006-02)']
  status handover_status [not null, default: 'DRAFT']
  handed_at datetime(6) [not null]
  recorded_by bigint
  landlord_confirmed_by bigint
  tenant_confirmed_person_id bigint [ref: >? ep03_ep04_contracts.persons.id]
  confirmed_at datetime(6)
  note text
  version int [not null, default: 0]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (contract_id, type, revision_no) [unique, name: 'uq_handovers_rev']
  }
  Note: 'Biên bản nhận/trả phòng. Ảnh qua file_links(entity_type=HANDOVER_ITEM).'
}

Table ep05_handover.handover_items [headercolor: #0369A1] {
  id bigint [pk, increment]
  handover_id bigint [not null, ref: > ep05_handover.handovers.id]
  asset_id bigint [not null, ref: > ep05_handover.room_assets.id]
  quantity decimal(12,2) [not null]
  item_condition asset_condition [not null, default: 'GOOD']
  condition_note varchar(255)
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (handover_id, asset_id) [unique, name: 'uq_handover_items']
  }
  Note: 'Không lưu tiền hư hỏng ở đây; khấu trừ nằm ở checkout_deductions để chỉ có một nguồn (BR-017).'
}

//////////////////////////////////////////////////////////////
// EP06 - DỊCH VỤ, BIỂU GIÁ, ĐỒNG HỒ, CHỈ SỐ, OCR
//////////////////////////////////////////////////////////////

Table ep06_utilities.services [headercolor: #CA8A04] {
  id bigint [pk, increment]
  organization_id bigint [not null]
  code varchar(50) [not null, note: 'ELECTRIC, WATER, WIFI, TRASH...']
  name varchar(150) [not null]
  unit varchar(30) [not null, note: 'kWh, m3, phòng, người, tháng']
  calculation_method service_calc_method [not null]
  person_day_eligible boolean [not null, default: false, note: 'Được chọn chia theo Ngày Người (BR-023)']
  status record_status [not null, default: 'ACTIVE']
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (organization_id, code) [unique, name: 'uq_services_org_code']
  }
}

Table ep06_utilities.service_prices [headercolor: #CA8A04] {
  id bigint [pk, increment]
  service_id bigint [not null, ref: > ep06_utilities.services.id]
  property_id bigint [ref: >? ep02_properties.properties.id, note: 'NULL = toàn tổ chức']
  room_id bigint [ref: >? ep02_properties.rooms.id, note: 'NULL = toàn khu']
  effective_from date [not null]
  effective_to date
  unit_price decimal(18,2) [not null, default: 0]
  tiers_json json [note: 'Bậc giá cho TIERED_METERED: [{from,to,price}]']
  created_by bigint
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (service_id, property_id, room_id, effective_from) [unique, name: 'uq_service_prices_scope_from']
  }
  Note: 'BR-009: giá có ngày hiệu lực; ứng dụng kiểm khoảng hiệu lực không chồng trong cùng phạm vi.'
}

Table ep06_utilities.meters [headercolor: #CA8A04] {
  id bigint [pk, increment]
  organization_id bigint [not null]
  room_id bigint [not null, ref: > ep02_properties.rooms.id]
  service_id bigint [not null, ref: > ep06_utilities.services.id]
  serial_number varchar(80)
  installed_at date [not null]
  initial_value decimal(18,4) [not null, default: 0]
  removed_at date
  final_value decimal(18,4)
  replaced_meter_id bigint [ref: >? ep06_utilities.meters.id, note: 'Đồng hồ cũ mà đồng hồ này thay thế']
  status meter_status [not null, default: 'ACTIVE']
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (room_id, service_id, status) [name: 'idx_meters_room_service_status']
  }
  Note: 'BR-007: thay đồng hồ giữ chuỗi cũ và mới, không sửa đè.'
}

Table ep06_utilities.meter_readings [headercolor: #CA8A04] {
  id bigint [pk, increment]
  organization_id bigint [not null]
  meter_id bigint [not null, ref: > ep06_utilities.meters.id]
  period_id bigint [ref: >? ep07_billing.billing_periods.id, note: 'NULL cho CHECK_IN trước kỳ đầu']
  reading_type reading_type [not null, default: 'REGULAR']
  previous_value decimal(18,4) [not null]
  current_value decimal(18,4) [not null, note: 'CHECK >= previous_value (AC-008-02)']
  read_at datetime(6) [not null]
  source reading_source [not null, default: 'MANUAL']
  ocr_job_id bigint [ref: >? ep06_utilities.ocr_jobs.id]
  photo_file_id bigint [ref: >? ep12_files_residence.stored_files.id]
  is_anomaly boolean [not null, default: false]
  anomaly_note varchar(255)
  status reading_status [not null, default: 'DRAFT']
  supersedes_reading_id bigint [ref: >? ep06_utilities.meter_readings.id]
  recorded_by bigint
  confirmed_by bigint
  confirmed_at datetime(6)
  version int [not null, default: 0]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (meter_id, period_id) [name: 'idx_meter_readings_meter_period']
    (period_id, status) [name: 'idx_meter_readings_period_status']
  }
  Note: '''
  Mỗi dòng là một đoạn chỉ số của một đồng hồ. Thay đồng hồ giữa kỳ = 2 dòng (cũ REPLACEMENT_CLOSE + mới REGULAR), tổng = 80 + 20 (AC-008-03).
  Tối đa 1 bản CONFIRMED cho (meter, period, reading_type) qua cột sinh ở V2. Chỉ CONFIRMED mới dùng lập hóa đơn (BR-008).
  '''
}

Table ep06_utilities.ocr_jobs [headercolor: #CA8A04] {
  id bigint [pk, increment]
  organization_id bigint [not null]
  file_id bigint [not null, ref: > ep12_files_residence.stored_files.id]
  meter_id bigint [ref: >? ep06_utilities.meters.id]
  provider varchar(60)
  suggested_value decimal(18,4)
  confidence decimal(5,4)
  raw_result json
  status ocr_status [not null, default: 'PENDING']
  error_message varchar(500)
  requested_by bigint
  reviewed_by bigint
  reviewed_at datetime(6)
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (meter_id, status) [name: 'idx_ocr_jobs_meter_status']
  }
  Note: 'BR-008: kết quả OCR chỉ là gợi ý; lỗi OCR không tự nhập số 0 (AC-009-03).'
}

//////////////////////////////////////////////////////////////
// EP07 - KỲ THU, HÓA ĐƠN, THU TIỀN, PHÂN BỔ
//////////////////////////////////////////////////////////////

Table ep07_billing.billing_periods [headercolor: #B91C1C] {
  id bigint [pk, increment]
  organization_id bigint [not null]
  contract_id bigint [not null, ref: > ep03_ep04_contracts.contracts.id]
  period_code varchar(20) [not null, note: 'Ví dụ 2026-11']
  date_from date [not null]
  date_to date [not null, note: 'CHECK >= date_from; tính cả 2 đầu']
  status period_status [not null, default: 'OPEN']
  locked_at datetime(6)
  locked_by bigint
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (contract_id, date_from) [unique, name: 'uq_billing_periods_contract_from']
    (contract_id, period_code) [unique, name: 'uq_billing_periods_contract_code']
    (organization_id, status) [name: 'idx_billing_periods_org_status']
  }
  Note: 'Kỳ thu của một hợp đồng (định nghĩa "Kỳ thu" trong BA). Kỳ LOCKED thì dữ liệu tính tiền chỉ sửa qua điều chỉnh.'
}

Table ep07_billing.invoices [headercolor: #B91C1C] {
  id bigint [pk, increment]
  organization_id bigint [not null]
  contract_id bigint [not null, ref: > ep03_ep04_contracts.contracts.id]
  period_id bigint [ref: >? ep07_billing.billing_periods.id, note: 'Bắt buộc với PERIODIC']
  invoice_no varchar(60) [not null]
  invoice_type invoice_type [not null, default: 'PERIODIC']
  status invoice_status [not null, default: 'DRAFT']
  subtotal_amount decimal(18,2) [not null, default: 0, note: 'Tổng invoice_items, cập nhật cùng transaction']
  due_date date
  issued_at datetime(6)
  issued_by bigint
  cancelled_at datetime(6)
  cancelled_by bigint
  cancel_reason varchar(255)
  generation_key varchar(120) [unique, note: 'Khóa chống lặp khi chạy lại tác vụ lập hóa đơn (BR-010)']
  policy_snapshot json [note: 'Chính sách và giá đã dùng khi lập']
  created_by bigint
  version int [not null, default: 0]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (organization_id, invoice_no) [unique, name: 'uq_invoices_org_no']
    (contract_id, status) [name: 'idx_invoices_contract_status']
    (organization_id, due_date, status) [name: 'idx_invoices_org_due_status']
  }
  Note: '''
  BR-009..BR-011, BR-015. Phải thu hiệu lực = subtotal + tổng invoice_adjustments APPROVED.
  Công nợ = phải thu hiệu lực - tổng payment_allocations ACTIVE. Quá hạn là cờ tính (due_date < hôm nay và còn nợ), không lưu.
  Hóa đơn ISSUED không sửa dòng; sửa qua invoice_adjustments.
  '''
}

Table ep07_billing.invoice_items [headercolor: #B91C1C] {
  id bigint [pk, increment]
  invoice_id bigint [not null, ref: > ep07_billing.invoices.id]
  line_no int [not null]
  item_type invoice_item_type [not null]
  service_id bigint [ref: >? ep06_utilities.services.id]
  rent_rate_id bigint [ref: >? ep03_ep04_contracts.rent_rates.id]
  meter_reading_id bigint [ref: >? ep06_utilities.meter_readings.id]
  description varchar(255) [not null]
  date_from date [note: 'Đoạn ngày áp dụng khi chia đoạn giá']
  date_to date
  quantity decimal(18,4) [not null, default: 1]
  unit_price decimal(18,2) [not null, default: 0]
  amount decimal(18,2) [not null]
  calculation_snapshot json [not null, note: 'Công thức, đơn giá, số ngày, nguồn dữ liệu (AC-010-01)']
  source_key varchar(120) [not null, note: 'Ví dụ RENT:rate42:2026-11-01, chống thêm dòng trùng khi chạy lại (AC-007-03)']
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (invoice_id, line_no) [unique, name: 'uq_invoice_items_line']
    (invoice_id, source_key) [unique, name: 'uq_invoice_items_source']
  }
}

Table ep07_billing.invoice_adjustments [headercolor: #B91C1C] {
  id bigint [pk, increment]
  invoice_id bigint [not null, ref: > ep07_billing.invoices.id]
  amount decimal(18,2) [not null, note: 'Âm = giảm, dương = tăng; CHECK <> 0']
  reason varchar(255) [not null]
  dispute_id bigint [ref: >? ep09_maintenance_disputes.disputes.id]
  allocation_batch_id bigint [ref: >? ep10_persondays.allocation_batches.id, note: 'Điều chỉnh do chia Ngày Người phiên bản mới']
  status adjustment_status [not null, default: 'DRAFT']
  created_by bigint [not null]
  approved_by bigint
  approved_at datetime(6)
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (invoice_id, status) [name: 'idx_invoice_adjustments_invoice_status']
  }
  Note: 'BR-011: sửa sau phát hành bằng chứng từ điều chỉnh có lý do. Giảm phải thu dưới số đã phân bổ phải đối soát trước.'
}

Table ep07_billing.payments [headercolor: #B91C1C] {
  id bigint [pk, increment]
  organization_id bigint [not null]
  contract_id bigint [not null, ref: > ep03_ep04_contracts.contracts.id, note: 'Chủ thể sở hữu tiền dư (BR-016)']
  payer_person_id bigint [ref: >? ep03_ep04_contracts.persons.id]
  amount decimal(18,2) [not null, note: 'CHECK > 0']
  received_at datetime(6) [not null]
  method payment_method [not null]
  idempotency_key varchar(100) [not null, unique, note: 'Gửi lặp không cộng tiền lần 2 (AC-011-02)']
  external_reference varchar(100) [note: 'Mã giao dịch ngân hàng']
  status payment_status [not null, default: 'CONFIRMED']
  corrects_payment_id bigint [ref: >? ep07_billing.payments.id, note: 'Phiếu này thay cho phiếu ghi sai (AC-011-04)']
  voided_at datetime(6)
  voided_by bigint
  void_reason varchar(255)
  note varchar(255)
  received_by bigint [not null]
  version int [not null, default: 0]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (contract_id, status) [name: 'idx_payments_contract_status']
    (organization_id, received_at) [name: 'idx_payments_org_received']
  }
  Note: '''
  BR-014. Phiếu thu tiền thuê/điện nước/dịch vụ; cọc ghi ở deposit_transactions, quỹ ở fund_transactions.
  Phiếu sai: chuyển VOIDED (đảo hết phân bổ) và tạo phiếu mới corrects_payment_id. Báo cáo chỉ cộng CONFIRMED.
  Tiền chưa phân bổ = amount - phân bổ ACTIVE - overpayment_refunds.
  '''
}

Table ep07_billing.payment_allocations [headercolor: #B91C1C] {
  id bigint [pk, increment]
  payment_id bigint [not null, ref: > ep07_billing.payments.id]
  invoice_id bigint [not null, ref: > ep07_billing.invoices.id]
  amount decimal(18,2) [not null, note: 'CHECK > 0']
  status allocation_status [not null, default: 'ACTIVE']
  allocated_by bigint [not null]
  allocated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  reversed_by bigint
  reversed_at datetime(6)
  reverse_reason varchar(255)
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (payment_id, status) [name: 'idx_payment_alloc_payment_status']
    (invoice_id, status) [name: 'idx_payment_alloc_invoice_status']
  }
  Note: 'Tổng phân bổ ACTIVE của một phiếu không vượt amount; của một hóa đơn không vượt phải thu hiệu lực (khóa dòng khi ghi).'
}

Table ep07_billing.overpayment_refunds [headercolor: #B91C1C] {
  id bigint [pk, increment]
  payment_id bigint [not null, ref: > ep07_billing.payments.id]
  amount decimal(18,2) [not null, note: 'CHECK > 0']
  refunded_at datetime(6) [not null]
  method payment_method [not null]
  idempotency_key varchar(100) [not null, unique]
  reason varchar(255)
  approved_by bigint [not null]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  Note: 'BR-016, Q05: hoàn lại phần tiền dư chưa phân bổ. Dùng cho kỳ sau = tạo phân bổ sang hóa đơn kỳ sau.'
}

Table ep07_billing.payment_reconciliations [headercolor: #B91C1C] {
  id bigint [pk, increment]
  payment_id bigint [not null, ref: > ep07_billing.payments.id]
  statement_reference varchar(100)
  status reconciliation_status [not null, default: 'PENDING']
  note varchar(255)
  reconciled_by bigint
  reconciled_at datetime(6)
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (payment_id) [name: 'idx_payment_recon_payment']
  }
  Note: 'Đối soát với sao kê ngân hàng (Q08).'
}

//////////////////////////////////////////////////////////////
// EP08 - TRẢ PHÒNG VÀ QUYẾT TOÁN
//////////////////////////////////////////////////////////////

Table ep08_checkout.checkouts [headercolor: #C2410C] {
  id bigint [pk, increment]
  organization_id bigint [not null]
  contract_id bigint [not null, ref: > ep03_ep04_contracts.contracts.id]
  requested_at datetime(6) [not null]
  requested_by bigint
  planned_date date
  checkout_date date [note: 'Ngày ra đã chốt']
  checkout_handover_id bigint [ref: >? ep05_handover.handovers.id]
  final_invoice_id bigint [ref: >? ep07_billing.invoices.id]
  outstanding_debt decimal(18,2) [not null, default: 0, note: 'Nợ chưa thanh toán sau phân bổ']
  extra_deductions decimal(18,2) [not null, default: 0, note: 'Khấu trừ APPROVED chưa nằm trong nợ']
  total_obligation decimal(18,2) [not null, default: 0, note: '= outstanding_debt + extra_deductions']
  deposit_available decimal(18,2) [not null, default: 0]
  deposit_used decimal(18,2) [not null, default: 0, note: '= MIN(deposit_available, total_obligation)']
  refund_amount decimal(18,2) [not null, default: 0, note: '= deposit_available - deposit_used']
  extra_charge decimal(18,2) [not null, default: 0, note: '= total_obligation - deposit_used']
  status checkout_status [not null, default: 'DRAFT']
  confirmed_by bigint
  confirmed_at datetime(6)
  tenant_acknowledged_at datetime(6)
  cancel_reason varchar(255)
  version int [not null, default: 0]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (contract_id, status) [name: 'idx_checkouts_contract_status']
  }
  Note: '''
  BR-017, US-012. Tối đa 1 quyết toán chưa hủy mỗi hợp đồng (cột sinh ở V2) -> xác nhận lặp không hoàn cọc 2 lần (AC-012-04).
  Ví dụ AC-012-02: nợ 800k + hư hỏng 300k = 1.100k; cọc 2.000k -> dùng 1.100k, hoàn 900k.
  '''
}

Table ep08_checkout.checkout_deductions [headercolor: #C2410C] {
  id bigint [pk, increment]
  checkout_id bigint [not null, ref: > ep08_checkout.checkouts.id]
  handover_item_id bigint [ref: >? ep05_handover.handover_items.id]
  maintenance_request_id bigint [ref: >? ep09_maintenance_disputes.maintenance_requests.id]
  reason varchar(255) [not null]
  amount decimal(18,2) [not null, note: 'CHECK >= 0']
  included_in_invoice_item_id bigint [ref: >? ep07_billing.invoice_items.id, note: 'Đã nằm trong nợ -> không cộng vào extra_deductions (BR-017)']
  status deduction_status [not null, default: 'PROPOSED']
  approved_by bigint
  approved_at datetime(6)
  created_by bigint
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (checkout_id, status) [name: 'idx_checkout_deductions_status']
  }
  Note: 'BR-018: khấu trừ có căn cứ (ảnh qua file_links) và xác nhận; PROPOSED/REJECTED không trừ cọc (AC-006-03).'
}

//////////////////////////////////////////////////////////////
// EP09 - BẢO TRÌ VÀ TRANH CHẤP
//////////////////////////////////////////////////////////////

Table ep09_maintenance_disputes.maintenance_requests [headercolor: #7C3AED] {
  id bigint [pk, increment]
  organization_id bigint [not null]
  room_id bigint [not null, ref: > ep02_properties.rooms.id]
  contract_id bigint [ref: >? ep03_ep04_contracts.contracts.id]
  reported_by bigint
  assigned_to bigint
  title varchar(200) [not null]
  description text
  priority maintenance_priority [not null, default: 'NORMAL']
  status maintenance_status [not null, default: 'NEW']
  blocks_room boolean [not null, default: false, note: 'Khóa không cho chuyển phòng về trống/kích hoạt hợp đồng']
  resolution_note text
  resolved_at datetime(6)
  recharge_invoice_item_id bigint [ref: >? ep07_billing.invoice_items.id, note: 'Phần thu lại người thuê đã duyệt (BR-019)']
  version int [not null, default: 0]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (organization_id, status) [name: 'idx_maintenance_org_status']
    (room_id, status) [name: 'idx_maintenance_room_status']
  }
  Note: 'Chi phí sửa ghi ở operating_expenses.maintenance_request_id (một lần), không lưu cost ở đây.'
}

Table ep09_maintenance_disputes.maintenance_status_history [headercolor: #7C3AED] {
  id bigint [pk, increment]
  request_id bigint [not null, ref: > ep09_maintenance_disputes.maintenance_requests.id]
  from_status maintenance_status
  to_status maintenance_status [not null]
  note varchar(500)
  changed_by bigint [not null]
  changed_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (request_id, changed_at) [name: 'idx_msh_request_time']
  }
  Note: 'AC-013-02: mỗi lần chuyển trạng thái lưu người, thời điểm, kết quả.'
}

Table ep09_maintenance_disputes.disputes [headercolor: #7C3AED] {
  id bigint [pk, increment]
  organization_id bigint [not null]
  contract_id bigint [not null, ref: > ep03_ep04_contracts.contracts.id]
  entity_type varchar(60) [not null, note: 'INVOICE, HANDOVER, CHECKOUT, DEPOSIT, OTHER']
  entity_id bigint
  subject varchar(200) [not null]
  details text
  status dispute_status [not null, default: 'OPEN']
  resolution text
  resolved_by bigint
  resolved_at datetime(6)
  opened_by bigint [not null]
  version int [not null, default: 0]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (contract_id, status) [name: 'idx_disputes_contract_status']
    (entity_type, entity_id) [name: 'idx_disputes_entity']
  }
  Note: 'BR-020: mở tranh chấp không tự xóa nợ; thay đổi tiền qua invoice_adjustments.dispute_id (AC-014-03).'
}

Table ep09_maintenance_disputes.dispute_parties [headercolor: #7C3AED] {
  id bigint [pk, increment]
  dispute_id bigint [not null, ref: > ep09_maintenance_disputes.disputes.id]
  user_id bigint [not null]
  role dispute_party_role [not null]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (dispute_id, user_id) [unique, name: 'uq_dispute_parties']
  }
  Note: 'Chỉ các bên liên quan được đọc tranh chấp (AC-014-02).'
}

Table ep09_maintenance_disputes.dispute_events [headercolor: #7C3AED] {
  id bigint [pk, increment]
  dispute_id bigint [not null, ref: > ep09_maintenance_disputes.disputes.id]
  author_user_id bigint [not null]
  event_type varchar(40) [not null, note: 'COMMENT, EVIDENCE, STATUS_CHANGE, RESOLUTION']
  content text
  from_status dispute_status
  to_status dispute_status
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (dispute_id, created_at) [name: 'idx_dispute_events_time']
  }
}

//////////////////////////////////////////////////////////////
// EP10 - NGÀY NGƯỜI
//////////////////////////////////////////////////////////////

Table ep10_persondays.absence_requests [headercolor: #DB2777] {
  id bigint [pk, increment]
  organization_id bigint [not null]
  occupancy_id bigint [not null, ref: > ep03_ep04_contracts.occupancies.id]
  date_from date [not null]
  date_to date [not null, note: 'CHECK >= date_from; phải nằm trong thời gian cư trú (AC-015-03)']
  reason varchar(255) [note: 'Riêng tư: thành viên khác không xem (BR-002)']
  residence_document_id bigint [ref: >? ep12_files_residence.residence_documents.id, note: 'Đề nghị từ hồ sơ tạm vắng (AC-020-03)']
  revision_no int [not null, default: 1]
  supersedes_request_id bigint [ref: >? ep10_persondays.absence_requests.id, note: 'Sửa sau chốt tạo bản mới']
  status absence_status [not null, default: 'DRAFT']
  submitted_by bigint
  submitted_at datetime(6)
  decided_by bigint
  decided_at datetime(6)
  reject_reason varchar(255)
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (occupancy_id, status) [name: 'idx_absence_occupancy_status']
  }
  Note: 'BR-022: chỉ APPROVED mới bị trừ; các khoảng chồng nhau được gộp khi tính.'
}

Table ep10_persondays.allocation_batches [headercolor: #DB2777] {
  id bigint [pk, increment]
  organization_id bigint [not null]
  contract_id bigint [not null, ref: > ep03_ep04_contracts.contracts.id]
  period_id bigint [not null, ref: > ep07_billing.billing_periods.id]
  service_id bigint [not null, ref: > ep06_utilities.services.id]
  invoice_id bigint [ref: >? ep07_billing.invoices.id, note: 'Hóa đơn phòng chứa số tiền được chia']
  revision_no int [not null, default: 1]
  supersedes_batch_id bigint [ref: >? ep10_persondays.allocation_batches.id]
  eligible_amount decimal(18,2) [not null, note: 'CHECK >= 0']
  total_person_days int [not null, default: 0]
  rounding_policy_id bigint [ref: >? ep02_properties.business_policies.id]
  status allocation_batch_status [not null, default: 'DRAFT']
  zero_weight_resolution varchar(500) [note: 'Lý do và quyết định khi tổng = 0 (BR-024)']
  confirmed_by bigint
  confirmed_at datetime(6)
  version int [not null, default: 0]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (period_id, service_id, revision_no) [unique, name: 'uq_allocation_batches_rev']
  }
  Note: 'BR-023: phần người = eligible_amount x person_days / total_person_days. Không đổi tổng hóa đơn phòng.'
}

Table ep10_persondays.person_day_allocations [headercolor: #DB2777] {
  id bigint [pk, increment]
  batch_id bigint [not null, ref: > ep10_persondays.allocation_batches.id]
  occupancy_id bigint [not null, ref: > ep03_ep04_contracts.occupancies.id]
  days_in_period int [not null, note: 'Số ngày giao giữa kỳ và thời gian cư trú, tính cả 2 đầu (BR-021)']
  absent_days int [not null, default: 0, note: 'Ngày vắng APPROVED sau khi gộp chồng lấn']
  person_days int [not null, note: '= days_in_period - absent_days, CHECK >= 0']
  raw_share decimal(20,6) [not null, note: 'Trước làm tròn']
  allocated_amount decimal(18,2) [not null]
  remainder_rank int [note: 'Thứ tự nhận phần dư (Q04)']
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (batch_id, occupancy_id) [unique, name: 'uq_person_day_alloc']
  }
  Note: 'GT-01: A16 B20 C30 D30, 960.000 -> 160k/200k/300k/300k. Tổng allocated_amount = eligible_amount.'
}

//////////////////////////////////////////////////////////////
// EP11 - QUỸ PHÒNG, MUA CHUNG, BÙ TRỪ
//////////////////////////////////////////////////////////////

Table ep11_roomfund.room_funds [headercolor: #15803D] {
  id bigint [pk, increment]
  organization_id bigint [not null]
  room_id bigint [not null, ref: > ep02_properties.rooms.id]
  contract_id bigint [not null, ref: > ep03_ep04_contracts.contracts.id, note: 'Quỹ của nhóm người thuê dưới hợp đồng này']
  name varchar(150) [not null]
  currency char(3) [not null, default: 'VND']
  status fund_status [not null, default: 'OPEN']
  opened_at datetime(6) [not null]
  closed_at datetime(6)
  close_note varchar(500) [note: 'Xử lý quyền hoàn còn lại khi đóng quỹ (Q09)']
  version int [not null, default: 0, note: 'Khóa dòng khi giữ chỗ để 2 yêu cầu không dùng chung số dư (BR-027)']
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (contract_id, status) [name: 'idx_room_funds_contract_status']
  }
  Note: '''
  Quỹ thuộc người thuê, chủ trọ không mặc nhiên sở hữu. Tách hoàn toàn với tiền chủ trọ (BR-036, BR-037).
  Tiền thực có = CONTRIBUTION + ADJUSTMENT_IN - CASH_EXPENSE - ADJUSTMENT_OUT.
  Khả dụng = tiền thực có - tổng (amount - released_amount) của reservations HELD. Không âm.
  '''
}

Table ep11_roomfund.fund_managers [headercolor: #15803D] {
  id bigint [pk, increment]
  fund_id bigint [not null, ref: > ep11_roomfund.room_funds.id]
  occupancy_id bigint [not null, ref: > ep03_ep04_contracts.occupancies.id]
  assigned_by bigint
  valid_from datetime(6) [not null]
  valid_to datetime(6)
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (fund_id, valid_to) [name: 'idx_fund_managers_active']
  }
  Note: 'Người thuê được phân công quản lý quỹ (Q09).'
}

Table ep11_roomfund.fund_obligations [headercolor: #15803D] {
  id bigint [pk, increment]
  fund_id bigint [not null, ref: > ep11_roomfund.room_funds.id]
  occupancy_id bigint [not null, ref: > ep03_ep04_contracts.occupancies.id]
  period_code varchar(20) [not null, note: 'Ví dụ 2026-11']
  due_date date
  amount_due decimal(18,2) [not null, note: 'CHECK >= 0']
  status obligation_status [not null, default: 'OPEN']
  version int [not null, default: 0]
  created_by bigint
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (fund_id, occupancy_id, period_code) [unique, name: 'uq_fund_obligations']
  }
  Note: 'Nghĩa vụ đóng quỹ mỗi kỳ. Còn phải nộp = amount_due - CONTRIBUTION gắn obligation - fund_offsets (AC-019-01).'
}

Table ep11_roomfund.fund_transactions [headercolor: #15803D] {
  id bigint [pk, increment]
  fund_id bigint [not null, ref: > ep11_roomfund.room_funds.id]
  type fund_txn_type [not null]
  amount decimal(18,2) [not null, note: 'CHECK > 0']
  occurred_at datetime(6) [not null]
  occupancy_id bigint [ref: >? ep03_ep04_contracts.occupancies.id, note: 'Người đóng với CONTRIBUTION']
  obligation_id bigint [ref: >? ep11_roomfund.fund_obligations.id]
  purchase_id bigint [ref: >? ep11_roomfund.shared_purchases.id, note: 'Chỉ khi chi tiền mặt thật từ quỹ']
  reverses_transaction_id bigint [ref: >? ep11_roomfund.fund_transactions.id]
  idempotency_key varchar(100) [not null, unique, note: 'Tăng quỹ đúng 1 lần (AC-017-01)']
  reference_code varchar(100)
  note varchar(255)
  created_by bigint [not null]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (fund_id, type) [name: 'idx_fund_txn_fund_type']
    (obligation_id) [name: 'idx_fund_txn_obligation']
  }
  Note: 'Sổ tiền thực của quỹ. Giữ chỗ và duyệt quyền hoàn KHÔNG tạo dòng ở đây (BR-030, AC-017-02).'
}

Table ep11_roomfund.shared_purchases [headercolor: #15803D] {
  id bigint [pk, increment]
  fund_id bigint [not null, ref: > ep11_roomfund.room_funds.id]
  requested_by_occupancy_id bigint [not null, ref: > ep03_ep04_contracts.occupancies.id]
  current_revision_no int [not null, default: 1]
  status purchase_status [not null, default: 'DRAFT']
  cancel_reason varchar(255)
  version int [not null, default: 0]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (fund_id, status) [name: 'idx_shared_purchases_fund_status']
  }
  Note: 'Đề nghị mua chung bằng tiền ứng cá nhân. Nội dung (số tiền, chứng từ) nằm ở shared_purchase_revisions.'
}

Table ep11_roomfund.shared_purchase_revisions [headercolor: #15803D] {
  id bigint [pk, increment]
  purchase_id bigint [not null, ref: > ep11_roomfund.shared_purchases.id]
  revision_no int [not null]
  title varchar(200) [not null]
  description text
  amount decimal(18,2) [not null, note: 'CHECK > 0']
  purchased_at date
  created_by bigint [not null]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (purchase_id, revision_no) [unique, name: 'uq_purchase_revisions']
  }
  Note: 'BR-026: đổi số tiền/chứng từ = revision mới; chứng từ qua file_links(entity_type=PURCHASE_REVISION).'
}

Table ep11_roomfund.purchase_approvals [headercolor: #15803D] {
  id bigint [pk, increment]
  purchase_id bigint [not null, ref: > ep11_roomfund.shared_purchases.id]
  revision_no int [not null]
  approver_occupancy_id bigint [not null, ref: > ep03_ep04_contracts.occupancies.id]
  decision approval_decision [not null]
  decided_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (purchase_id, revision_no, approver_occupancy_id) [unique, name: 'uq_purchase_approvals']
  }
  Note: 'BR-025: cần >= 2 APPROVE của revision hiện tại từ người KHÁC người đề nghị (trigger V2 chặn tự duyệt). Xác nhận lặp bị unique chặn.'
}

Table ep11_roomfund.fund_reservations [headercolor: #15803D] {
  id bigint [pk, increment]
  fund_id bigint [not null, ref: > ep11_roomfund.room_funds.id]
  purchase_id bigint [not null, ref: > ep11_roomfund.shared_purchases.id]
  revision_no int [not null]
  amount decimal(18,2) [not null, note: 'CHECK > 0']
  released_amount decimal(18,2) [not null, default: 0, note: 'CHECK 0 <= released <= amount']
  status reservation_status [not null, default: 'HELD']
  created_by bigint [not null]
  version int [not null, default: 0]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (fund_id, status) [name: 'idx_fund_reservations_fund_status']
  }
  Note: 'BR-027: tối đa 1 giữ chỗ HELD mỗi đề nghị (cột sinh V2). Kiểm quỹ + giữ chỗ trong cùng transaction có khóa room_funds.'
}

Table ep11_roomfund.fund_refund_entitlements [headercolor: #15803D] {
  id bigint [pk, increment]
  fund_id bigint [not null, ref: > ep11_roomfund.room_funds.id]
  purchase_id bigint [not null, unique, ref: - ep11_roomfund.shared_purchases.id]
  occupancy_id bigint [not null, ref: > ep03_ep04_contracts.occupancies.id, note: 'Người đã ứng tiền']
  amount decimal(18,2) [not null, note: 'CHECK > 0']
  remaining_amount decimal(18,2) [not null, note: 'CHECK 0 <= remaining <= amount']
  status entitlement_status [not null, default: 'ACTIVE']
  version int [not null, default: 0]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (occupancy_id, status) [name: 'idx_entitlements_occupancy_status']
  }
  Note: 'Quyền hoàn; phần chưa dùng chuyển kỳ (BR-029). Rời phòng/đóng quỹ -> ON_HOLD chờ xử lý theo Q09, không tự xóa.'
}

Table ep11_roomfund.fund_offsets [headercolor: #15803D] {
  id bigint [pk, increment]
  entitlement_id bigint [not null, ref: > ep11_roomfund.fund_refund_entitlements.id]
  obligation_id bigint [not null, ref: > ep11_roomfund.fund_obligations.id, note: 'Chỉ bù vào nghĩa vụ đóng quỹ, KHÔNG vào hóa đơn chủ trọ (BR-028)']
  reservation_id bigint [not null, ref: > ep11_roomfund.fund_reservations.id, note: 'Giải phóng phần giữ chỗ tương ứng']
  amount decimal(18,2) [not null, note: 'CHECK > 0; <= remaining_amount và <= nghĩa vụ còn phải nộp']
  idempotency_key varchar(100) [not null, unique, note: 'Chạy lại không bù lần 2 (AC-019-03)']
  approved_by bigint
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (entitlement_id) [name: 'idx_fund_offsets_entitlement']
    (obligation_id) [name: 'idx_fund_offsets_obligation']
  }
  Note: 'GT-06: nghĩa vụ 200k, quyền hoàn 120k -> bù 120k, nộp 80k. GT-07: nghĩa vụ 100k, quyền 120k -> bù 100k, còn 20k.'
}

//////////////////////////////////////////////////////////////
// EP12 - TỆP, HỒ SƠ CƯ TRÚ, PDF
//////////////////////////////////////////////////////////////

Table ep12_files_residence.stored_files [headercolor: #4D7C0F] {
  id bigint [pk, increment]
  organization_id bigint [note: 'NULL chỉ với tệp hệ thống']
  storage_key varchar(500) [not null, unique, note: 'Khóa lưu trữ nội bộ, không phải URL công khai']
  original_name varchar(255) [not null]
  mime_type varchar(120) [not null]
  size_bytes bigint [not null, note: 'CHECK >= 0']
  sha256 char(64) [not null]
  visibility file_visibility [not null, default: 'PRIVATE']
  uploaded_by bigint
  retention_until date [note: 'Theo Q13']
  deleted_at datetime(6)
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (organization_id) [name: 'idx_stored_files_org']
  }
  Note: 'BR-032, NFR09: tải tệp luôn kiểm quyền qua đối tượng liên kết; biết storage_key không có quyền.'
}

Table ep12_files_residence.file_links [headercolor: #4D7C0F] {
  id bigint [pk, increment]
  file_id bigint [not null, ref: > ep12_files_residence.stored_files.id]
  entity_type varchar(60) [not null, note: 'HANDOVER_ITEM, METER_READING, PAYMENT, PURCHASE_REVISION, CHECKOUT_DEDUCTION, MAINTENANCE, DISPUTE, LISTING, EXPENSE...']
  entity_id bigint [not null]
  purpose varchar(60) [not null, note: 'PHOTO, RECEIPT, EVIDENCE, PDF']
  created_by bigint
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (entity_type, entity_id) [name: 'idx_file_links_entity']
    (file_id) [name: 'idx_file_links_file']
  }
}

Table ep12_files_residence.file_access_logs [headercolor: #4D7C0F] {
  id bigint [pk, increment]
  file_id bigint [not null, ref: > ep12_files_residence.stored_files.id]
  user_id bigint
  action file_access_action [not null]
  result access_result [not null]
  ip_address varchar(45)
  occurred_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (file_id, occurred_at) [name: 'idx_file_access_file_time']
    (user_id, occurred_at) [name: 'idx_file_access_user_time']
  }
  Note: 'BR-032: nhật ký tải tệp, kể cả lần bị từ chối (GT-14).'
}

Table ep12_files_residence.residence_form_templates [headercolor: #4D7C0F] {
  id bigint [pk, increment]
  code varchar(60) [not null]
  version_label varchar(30) [not null]
  document_type residence_doc_type [not null]
  name varchar(200) [not null]
  schema_json json [not null, note: 'Danh sách trường và trường bắt buộc']
  effective_from date [not null]
  status template_status [not null, default: 'DRAFT']
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (code, version_label) [unique, name: 'uq_residence_templates']
  }
  Note: 'Mẫu hồ sơ theo Q10.'
}

Table ep12_files_residence.residence_documents [headercolor: #4D7C0F] {
  id bigint [pk, increment]
  organization_id bigint [not null]
  person_id bigint [not null, ref: > ep03_ep04_contracts.persons.id]
  contract_id bigint [ref: >? ep03_ep04_contracts.contracts.id]
  document_type residence_doc_type [not null]
  current_revision_no int [not null, default: 1]
  status residence_doc_status [not null, default: 'DRAFT']
  created_by bigint
  version int [not null, default: 0]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (person_id, status) [name: 'idx_residence_docs_person_status']
  }
  Note: 'BR-031: VERIFIED chỉ là đã kiểm tra trong hệ thống, KHÔNG phải đã hoàn tất thủ tục với cơ quan (AC-021-03).'
}

Table ep12_files_residence.residence_document_versions [headercolor: #4D7C0F] {
  id bigint [pk, increment]
  document_id bigint [not null, ref: > ep12_files_residence.residence_documents.id]
  revision_no int [not null]
  template_id bigint [not null, ref: > ep12_files_residence.residence_form_templates.id]
  form_data json [not null]
  submitted_by bigint
  submitted_at datetime(6)
  review_decision varchar(20) [note: 'VERIFIED hoặc NEEDS_REVISION']
  review_comment text [note: 'Ý kiến kiểm tra của phiên bản này (AC-020-02)']
  reviewed_by bigint
  reviewed_at datetime(6)
  pdf_file_id bigint [ref: >? ep12_files_residence.stored_files.id, note: 'PDF gắn đúng phiên bản (AC-021-01)']
  pdf_exported_at datetime(6)
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (document_id, revision_no) [unique, name: 'uq_residence_doc_versions']
  }
}

//////////////////////////////////////////////////////////////
// EP13 - TÌM PHÒNG
//////////////////////////////////////////////////////////////

Table ep13_listings.room_listings [headercolor: #0891B2] {
  id bigint [pk, increment]
  organization_id bigint [not null]
  room_id bigint [not null, ref: > ep02_properties.rooms.id]
  title varchar(200) [not null]
  description text
  listed_price decimal(18,2) [not null, note: 'CHECK >= 0']
  public_address varchar(255) [not null, note: 'Chỉ dữ liệu chủ trọ cho phép công khai']
  city varchar(100)
  district varchar(100)
  area_m2 decimal(10,2)
  max_occupants int
  amenities_json json
  status listing_status [not null, default: 'DRAFT']
  submitted_at datetime(6)
  moderated_by bigint
  moderated_at datetime(6)
  reject_reason varchar(500) [note: 'AC-022-02']
  published_at datetime(6)
  closed_at datetime(6)
  created_by bigint [not null]
  version int [not null, default: 0]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (status, city, district, listed_price) [name: 'idx_listings_search']
    (room_id) [name: 'idx_listings_room']
  }
  Note: 'BR-033: chỉ PUBLISHED được tìm công khai; đăng tin không đổi trạng thái phòng. Ảnh qua file_links (PUBLIC).'
}

Table ep13_listings.rental_inquiries [headercolor: #0891B2] {
  id bigint [pk, increment]
  listing_id bigint [not null, ref: > ep13_listings.room_listings.id]
  seeker_user_id bigint [note: 'NULL nếu khách không đăng nhập']
  contact_name varchar(150) [not null]
  contact_phone varchar(30)
  contact_email varchar(190)
  message text
  status inquiry_status [not null, default: 'NEW']
  handled_by bigint
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (listing_id, status) [name: 'idx_inquiries_listing_status']
  }
  Note: 'Tin CLOSED không nhận yêu cầu mới (AC-023-03, kiểm ở ứng dụng).'
}

Table ep13_listings.viewing_appointments [headercolor: #0891B2] {
  id bigint [pk, increment]
  inquiry_id bigint [not null, ref: > ep13_listings.rental_inquiries.id]
  scheduled_at datetime(6) [not null]
  duration_minutes int [not null, default: 30]
  status appointment_status [not null, default: 'PROPOSED']
  assigned_to bigint
  confirmed_by bigint
  confirmed_at datetime(6)
  cancel_reason varchar(255)
  version int [not null, default: 0]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (assigned_to, scheduled_at) [name: 'idx_appointments_staff_time']
  }
  Note: 'BR-034: COMPLETED không tự tạo hợp đồng hay thu cọc (AC-024-03).'
}

Table ep13_listings.appointment_history [headercolor: #0891B2] {
  id bigint [pk, increment]
  appointment_id bigint [not null, ref: > ep13_listings.viewing_appointments.id]
  from_status appointment_status
  to_status appointment_status [not null]
  old_scheduled_at datetime(6)
  new_scheduled_at datetime(6)
  note varchar(255)
  changed_by bigint
  changed_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (appointment_id, changed_at) [name: 'idx_appt_history_time']
  }
  Note: 'AC-024-02: đổi hoặc hủy lịch lưu lịch sử.'
}

//////////////////////////////////////////////////////////////
// EP14 - VẬN HÀNH CHỦ TRỌ: CHI PHÍ, NHẮC VIỆC, THÔNG BÁO
//////////////////////////////////////////////////////////////

Table ep14_operations.operating_expenses [headercolor: #9333EA] {
  id bigint [pk, increment]
  organization_id bigint [not null]
  property_id bigint [not null, ref: > ep02_properties.properties.id]
  room_id bigint [ref: >? ep02_properties.rooms.id]
  maintenance_request_id bigint [ref: >? ep09_maintenance_disputes.maintenance_requests.id]
  category expense_category [not null]
  amount decimal(18,2) [not null, note: 'CHECK > 0']
  expense_date date [not null]
  description varchar(255)
  vendor varchar(150)
  document_ref varchar(100) [note: 'Số chứng từ chi; unique trong tổ chức để không ghi trùng (AC-025-02)']
  status expense_status [not null, default: 'RECORDED']
  replaces_expense_id bigint [ref: >? ep14_operations.operating_expenses.id, note: 'Điều chỉnh giữ bản gốc (AC-025-03)']
  voided_at datetime(6)
  voided_by bigint
  void_reason varchar(255)
  recorded_by bigint [not null]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (organization_id, document_ref) [unique, name: 'uq_expenses_org_docref']
    (property_id, expense_date) [name: 'idx_expenses_property_date']
    (maintenance_request_id) [name: 'idx_expenses_maintenance']
  }
  Note: 'BR-037: chi của chủ trọ; không lấy từ quỹ người thuê, không trộn cọc.'
}

Table ep14_operations.reminders [headercolor: #9333EA] {
  id bigint [pk, increment]
  organization_id bigint [not null]
  reminder_key varchar(200) [not null, unique, note: 'loại:đối tượng:id:mốc, ví dụ INVOICE_OVERDUE:INVOICE:15:2026-11-10 (BR-035)']
  reminder_type varchar(60) [not null, note: 'MISSING_READING, MISSING_INVOICE, INVOICE_OVERDUE, CONTRACT_EXPIRING, BACKUP_FAILED...']
  entity_type varchar(60) [not null]
  entity_id bigint [not null]
  due_at datetime(6) [not null]
  assignee_user_id bigint
  status reminder_status [not null, default: 'OPEN']
  resolved_at datetime(6)
  resolved_by bigint
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (organization_id, status, due_at) [name: 'idx_reminders_org_status_due']
    (entity_type, entity_id) [name: 'idx_reminders_entity']
  }
  Note: 'Việc cần làm; trước khi gửi phải kiểm lại điều kiện (hóa đơn đã trả đủ thì không nhắc, AC-027-02).'
}

Table ep14_operations.notifications [headercolor: #9333EA] {
  id bigint [pk, increment]
  user_id bigint [not null]
  reminder_id bigint [ref: >? ep14_operations.reminders.id]
  channel notification_channel [not null, default: 'IN_APP']
  title varchar(200) [not null]
  body text
  dedupe_key varchar(200) [not null, unique, note: 'Không gửi lặp khi tác vụ chạy lại (AC-027-03)']
  status notification_status [not null, default: 'PENDING']
  attempt_count int [not null, default: 0]
  last_error varchar(500)
  sent_at datetime(6)
  read_at datetime(6)
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (user_id, status) [name: 'idx_notifications_user_status']
  }
  Note: 'Kênh gửi theo Q11.'
}

//////////////////////////////////////////////////////////////
// EP15 - NHẬT KÝ, SAO LƯU, CHỐNG LẶP
//////////////////////////////////////////////////////////////

Table ep15_audit_backup.audit_logs [headercolor: #334155] {
  id bigint [pk, increment]
  organization_id bigint
  actor_user_id bigint
  entity_type varchar(80) [not null]
  entity_id bigint [not null]
  action varchar(60) [not null, note: 'CREATE, UPDATE, ISSUE, VOID, APPROVE, GRANT, REVOKE, LOGIN...']
  before_json json [note: 'Không chứa mật khẩu, secret, số giấy tờ đầy đủ']
  after_json json
  reason varchar(500)
  request_id varchar(64) [note: 'Mã tra cứu lỗi (NFR07)']
  ip_address varchar(45)
  occurred_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (entity_type, entity_id, occurred_at) [name: 'idx_audit_entity_time']
    (organization_id, occurred_at) [name: 'idx_audit_org_time']
    (actor_user_id, occurred_at) [name: 'idx_audit_actor_time']
  }
  Note: 'BR-038: chỉ thêm. Trigger V2 chặn UPDATE/DELETE (AC-028-02).'
}

Table ep15_audit_backup.backup_jobs [headercolor: #334155] {
  id bigint [pk, increment]
  backup_type varchar(30) [not null, default: 'FULL']
  started_at datetime(6) [not null]
  finished_at datetime(6)
  status backup_status [not null, default: 'RUNNING']
  manifest_file_id bigint [ref: >? ep12_files_residence.stored_files.id, note: 'Danh mục tệp kèm checksum']
  database_checksum char(64)
  files_count int
  total_bytes bigint
  error_message varchar(1000)
  triggered_by bigint
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  indexes {
    (status, started_at) [name: 'idx_backup_jobs_status_time']
  }
  Note: 'BR-039, AC-029-01: thất bại phải ghi nhận và tạo reminder cho người phụ trách.'
}

Table ep15_audit_backup.restore_tests [headercolor: #334155] {
  id bigint [pk, increment]
  backup_job_id bigint [not null, ref: > ep15_audit_backup.backup_jobs.id]
  environment varchar(60) [not null, note: 'Môi trường tách biệt']
  started_at datetime(6) [not null]
  finished_at datetime(6)
  status restore_status [not null, default: 'RUNNING']
  target_rpo_minutes int
  target_rto_minutes int
  measured_rpo_minutes int
  measured_rto_minutes int
  checks_json json [note: 'Kết quả đối chiếu số dư, số hợp đồng, PDF, ảnh (AC-029-02)']
  verified_by bigint
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  Note: 'AC-029-03: không đánh dấu PASSED chỉ vì có tệp sao lưu.'
}

Table ep15_audit_backup.idempotency_keys [headercolor: #334155] {
  id bigint [pk, increment]
  scope varchar(60) [not null, note: 'ISSUE_INVOICE, CONFIRM_CHECKOUT, RESERVE_FUND...']
  idem_key varchar(100) [not null]
  user_id bigint
  request_hash char(64) [not null]
  status idempotency_status [not null, default: 'IN_PROGRESS']
  response_entity_type varchar(60)
  response_entity_id bigint
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  expires_at datetime(6) [not null]
  indexes {
    (scope, idem_key) [unique, name: 'uq_idempotency_scope_key']
  }
  Note: 'NFR03: gửi lại cùng yêu cầu trả về kết quả cũ thay vì tạo bản ghi mới.'
}

