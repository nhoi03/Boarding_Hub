  CANCELLED
}
Enum approval_decision {
  APPROVE
  REJECT
}
Enum reservation_status {
  HELD
  RELEASED
  CANCELLED
}
Enum entitlement_status {
  ACTIVE
  EXHAUSTED
  ON_HOLD
  CLOSED
}

Enum file_visibility {
  PRIVATE
  PUBLIC
}
Enum file_access_action {
  VIEW
  DOWNLOAD
  EXPORT
}
Enum access_result {
  ALLOWED
  DENIED
}
Enum residence_doc_type {
  TEMPORARY_RESIDENCE
  TEMPORARY_ABSENCE
}
Enum residence_doc_status {
  DRAFT
  SUBMITTED
  NEEDS_REVISION
  VERIFIED
}
Enum template_status {
