// BoardingHub - DBML cho dbdiagram.io
// Theo tài liệu BA BH-BA-001 v1.1 (03/11/2026). MySQL 8.0, InnoDB, utf8mb4.
// File SQL sinh từ file này: V1__schema.sql. Ràng buộc bổ sung (CHECK, generated column, trigger): V2__constraints_and_triggers.sql.

Project BoardingHub {
  database_type: 'MySQL'
  Note: '''
  Bản hiển thị: ẩn đường nối từ cột người thao tác (*_by -> users) và organization_id ngoài nhóm EP01/EP02 cho dễ nhìn. Trong SQL chúng vẫn là khóa ngoại. File chuẩn: boardinghub.dbml.

  Schema đề xuất v2.0 theo BA v1.1.

  Giả định đã chọn cho các câu hỏi mở (đổi được qua business_policies):
  - Q01: thuê nguyên phòng; một phòng tối đa một hợp đồng ACTIVE hoặc EXPIRED chưa trả phòng; nhiều người ở dưới một hợp đồng.
  - Q02: chính sách tính tiền phòng giữa tháng lưu trên từng hợp đồng; NOT_SET thì không chốt tiền phòng.
  - Q03: kỳ thu gắn theo hợp đồng (billing_periods.contract_id), hỗ trợ cả tháng lịch và ngày kỷ niệm hợp đồng.
  - Q04: làm tròn đến 1 đồng; chia dư theo phần thập phân lớn nhất, hòa thì theo occupancy_id.
  - Q05: người thu tiền chọn hóa đơn để phân bổ; phần chưa phân bổ hiển thị riêng.
  - Q07: múi giờ nghiệp vụ Asia/Ho_Chi_Minh (UTC+7).

  Quy ước:
  - Tiền decimal(18,2) VND. Không sửa đè hoặc xóa chứng từ tiền; sửa bằng phiên bản, điều chỉnh hoặc hủy có lý do.
  - Cột version dùng cho optimistic locking (BR-040).
  - Mọi khóa ngoại ON DELETE RESTRICT.
  - Số dư (công nợ, cọc, quỹ) được tính từ giao dịch, không lưu cứng.
  '''
}

//////////////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////////////

Enum user_status {
  ACTIVE
  LOCKED
  DISABLED
}
Enum role_scope {
  PLATFORM
  ORGANIZATION
  PROPERTY
  ROOM
}
Enum record_status {
  ACTIVE
  INACTIVE
}
Enum policy_status {
  DRAFT
  APPROVED
  RETIRED
}
Enum room_status {
  VACANT
  OCCUPIED
  MAINTENANCE
  INACTIVE
}

Enum contract_status {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  CANCELLED
}
Enum billing_cycle {
  CALENDAR_MONTH
  CONTRACT_ANNIVERSARY
}
Enum proration_policy {
  NOT_SET [note: 'Chưa chốt Q02: không được chốt tiền phòng giữa tháng']
  ACTUAL_DAYS_INCLUSIVE [note: 'Giá tháng x số ngày ở (tính cả 2 đầu) / số ngày thực của tháng']
  FIXED_30_INCLUSIVE [note: 'Giá tháng x số ngày ở / 30']
  FULL_MONTH [note: 'Tính đủ tháng']
}
Enum contract_change_type {
  CREATE
  RENEW
  EARLY_TERMINATE
  PRICE_CHANGE
  TERMS_CHANGE
}
Enum version_status {
  DRAFT
  APPROVED
  CANCELLED
}
Enum occupancy_role {
  REPRESENTATIVE
  MEMBER
}
Enum occupancy_status {
  PLANNED
  ACTIVE
  ENDED
  CANCELLED
}
Enum deposit_txn_type {
  RECEIVE
  APPLY_TO_DEBT
  REFUND
}
Enum payment_method {
  CASH
  BANK_TRANSFER
  E_WALLET
  OTHER
}

Enum asset_status {
  IN_USE
  BROKEN
  REMOVED
}
Enum handover_type {
  CHECK_IN
  CHECK_OUT
}
Enum handover_status {
  DRAFT
  CONFIRMED
  SUPERSEDED
}
Enum asset_condition {
  GOOD
  WORN
  DAMAGED
  MISSING
}

Enum service_calc_method {
  METERED
  TIERED_METERED
  PER_ROOM
  PER_PERSON
  FIXED
}
Enum meter_status {
  ACTIVE
  REPLACED
  INACTIVE
}
Enum reading_type {
  REGULAR [note: 'Đoạn chỉ số trong kỳ']
  CHECK_IN [note: 'Chỉ số đầu khi nhận phòng']
  CHECK_OUT [note: 'Chỉ số cuối khi trả phòng']
  REPLACEMENT_CLOSE [note: 'Chốt đồng hồ cũ khi thay']
}
Enum reading_source {
  MANUAL
  OCR
}
Enum reading_status {
  DRAFT
  CONFIRMED
  SUPERSEDED
}
Enum ocr_status {
  PENDING
  SUCCEEDED
  FAILED
  REVIEWED
}

Enum period_status {
  OPEN
  LOCKED
  CLOSED
}
Enum invoice_type {
  PERIODIC [note: 'Hóa đơn gốc của kỳ; tối đa 1 bản còn hiệu lực mỗi kỳ (BR-010)']
  CHECKOUT [note: 'Hóa đơn cuối khi trả phòng']
  ONE_OFF [note: 'Khoản phát sinh riêng, ví dụ thu lại chi phí sửa chữa']
}
Enum invoice_status {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}
Enum invoice_item_type {
  RENT
  UTILITY
  SERVICE
  DAMAGE
  MAINTENANCE_RECHARGE
  OTHER
}
Enum adjustment_status {
  DRAFT
  APPROVED
  CANCELLED
}
Enum payment_status {
  CONFIRMED
  VOIDED
}
Enum allocation_status {
  ACTIVE
  REVERSED
}
Enum reconciliation_status {
  PENDING
  MATCHED
  MISMATCHED
}

Enum checkout_status {
  DRAFT
  PENDING_CONFIRMATION
  CONFIRMED
  CANCELLED
}
Enum deduction_status {
  PROPOSED
  APPROVED
  REJECTED
}

Enum maintenance_priority {
  LOW
  NORMAL
  HIGH
  URGENT
}
Enum maintenance_status {
  NEW
  ACCEPTED
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}
Enum dispute_status {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
  CLOSED
}
Enum dispute_party_role {
  OPENER
  RESPONDENT
  HANDLER
  OBSERVER
}

Enum absence_status {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  SUPERSEDED
}
Enum allocation_batch_status {
  DRAFT
  PENDING_ZERO_WEIGHT [note: 'Tổng Ngày Người = 0, chờ xử lý (BR-024)']
  CONFIRMED
  SUPERSEDED
}

Enum fund_status {
  OPEN
  CLOSED
}
Enum obligation_status {
  OPEN
  SETTLED
  WAIVED
}
Enum fund_txn_type {
  CONTRIBUTION [note: 'Tiền đóng quỹ thực nhận']
  CASH_EXPENSE [note: 'Chi tiền mặt từ quỹ']
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}
Enum purchase_status {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  WAITING_FUNDS
  RESERVED
  PARTIALLY_OFFSET
  COMPLETED
