@startuml
title 5. Vận hành và hệ thống — EP01, EP09, EP14, EP15
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor #F5F3FF
  BorderColor #7C3AED
}

actor "Người dùng" as ND
actor "Nhân viên" as NV
actor "Chủ trọ" as CT
actor "Người thuê" as NT
actor "Người vận hành" as VH
actor "Bộ hẹn giờ" as TIMER <<system>>
ND <|-- NV
ND <|-- NT
NV <|-- CT

rectangle "Vận hành" {
  usecase "Đăng nhập (US-001)" as UC1
  usecase "Phân công, cấp quyền" as UC1b
  usecase "Báo hỏng (US-013)" as UC13a
  usecase "Xử lý bảo trì" as UC13
  usecase "Mở và giải quyết\ntranh chấp (US-014)" as UC14
  usecase "Ghi chi phí vận hành\n(US-025)" as UC25
  usecase "Xem tổng quan,\nbáo cáo (US-026)" as UC26
  usecase "Kiểm tra và gửi\nnhắc việc (US-027)" as UC27
  usecase "Tra cứu nhật ký\n(US-028)" as UC28
  usecase "Sao lưu và\nthử khôi phục (US-029)" as UC29
}

ND --> UC1
CT --> UC1b
NT --> UC13a
NV --> UC13
UC25 .> UC13 : <<extend>>\nchi phí sửa
NT --> UC14
CT --> UC14
CT --> UC25
CT --> UC26
TIMER --> UC27
CT --> UC28
VH --> UC29
TIMER --> UC29
@enduml
